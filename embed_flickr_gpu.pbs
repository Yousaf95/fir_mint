#!/bin/bash
#PBS -N fir_embed_flickr
#PBS -q commonGPUQ
#PBS -l select=1:ncpus=8:ngpus=1:mem=64gb:gpu_type=H100
#PBS -l walltime=07:59:00
#PBS -j oe
#PBS -o /home/$USER/RAO_OCT/logs/embed_flickr_gpu.out

set -euo pipefail
RAO=/home/$USER/RAO_OCT
ROOT="$RAO/data/flickr30k/.kagglehub/datasets/hsankesara/flickr-image-dataset/versions/1/flickr30k_images"
export HF_HOME="$RAO/cache/huggingface"
export TRANSFORMERS_CACHE="$HF_HOME"
export PYTHONUNBUFFERED=1
PY="$RAO/venv/bin/python"
mkdir -p "$RAO/logs" "$RAO/embeddings"
cd "$RAO"
module load Python/3.11.5-GCCcore-13.2.0
module load CUDA/12.6.0
hostname
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader
"$PY" - <<'PY'
import torch
assert torch.cuda.is_available()
print("torch:", torch.__version__)
print("device:", torch.cuda.get_device_name(0))
assert "H100" in torch.cuda.get_device_name(0)
PY
"$PY" -m py_compile code_frozen/embed_multi.py
"$PY" code_frozen/embed_multi.py --dataset flickr --root "$ROOT" \
  --models b32 --n_data 28000 --n_query 2000 --seed 0 \
  --out "$RAO/embeddings/flickr_28k_4col"
