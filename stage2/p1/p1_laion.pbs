#!/bin/bash
#PBS -N p1_laion_1m
#PBS -q commonCPUQ
#PBS -l select=1:ncpus=28:mem=300gb:cpu_type=Xeon2680
#PBS -l place=excl
#PBS -l walltime=24:00:00
#PBS -j oe
#PBS -o /home/$USER/RAO_OCT/logs/p1_laion_1m.out
set -euo pipefail
RAO=/home/$USER/RAO_OCT
export FIR_BUILD_THREADS=28 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 OMP_NUM_THREADS=1 PYTHONUNBUFFERED=1
cd "$RAO"
echo "host $(hostname) commit $(git rev-parse HEAD) start $(date -Is)"
lscpu | grep -E "Model name|^CPU\(s\)"; uptime
"$RAO/venv/bin/python" stage2/p1/p1_scale.py --data embeddings/laion_1m_4col --out results/p1 \
  2>&1 | tee "$RAO/logs/p1_laion_1m.log"
echo "end $(date -Is)"; uptime
